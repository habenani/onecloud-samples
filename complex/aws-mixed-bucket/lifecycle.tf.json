{
  "resource": {
    "aws_s3_bucket_lifecycle_configuration": {
      "this": {
        "bucket": "${aws_s3_bucket.this.id}",
        "rule": [
          {
            "id": "expire",
            "status": "Enabled",
            "filter": [{}],
            "expiration": [{ "days": "${var.expiry_days}" }]
          }
        ]
      }
    }
  },
  "output": {
    "bucket": { "value": "${aws_s3_bucket.this.id}" }
  }
}
